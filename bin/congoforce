#!/usr/bin/env python3
"""CongoForce helper launcher. Stdlib only; Python 3.9+."""
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("congoforce needs Python 3.9 or newer\n")
    sys.exit(2)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from congoforce.cli import main  # noqa: E402

sys.exit(main())
